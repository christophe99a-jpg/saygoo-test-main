{
  "name": "saygoo-backend",
  "version": "1.0.0",
  "description": "Backend API - Plateforme Logistech SAYGOO",
  "main": "src/server.js",
  "scripts": {
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "dev:server": "nodemon src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:auth": "jest tests/unit/auth.test.js --runInBand",
    "test:dossiers": "jest tests/unit/dossier.test.js --runInBand",
    "test:transport": "jest tests/unit/transport.test.js --runInBand",
    "test:health": "jest tests/unit/health.test.js --runInBand"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.6.13",
    "sequelize": "^6.35.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "concurrently": "^10.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  }
}
